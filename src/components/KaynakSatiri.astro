---
/** Verinin dayandığı resmi belge, doğrulama durumu, son güncelleme ve hata bildirimi. */
import { hataBildirUrl, tarihYaz } from '../lib/mufredat.js';
import { site } from '../site.config.js';

interface Props {
  belge?: { data: { baslik: string; url: string; yil: number; kontrolTarihi: Date } };
  dogrulandi: boolean;
  guncelleme?: Date;
  baslik: string;
}
const { belge, dogrulandi, guncelleme, baslik } = Astro.props;
const bildir = hataBildirUrl(site.repo, { baslik, sayfa: Astro.url.pathname });
---
<aside class="kaynak-satiri" aria-label="Kaynak" data-pagefind-ignore>
  <p>
    <strong>Kaynak:</strong>
    {belge ? <a href={belge.data.url} rel="noopener noreferrer">{belge.data.baslik}</a> : 'belirtilmedi'}
    {' '}
    {dogrulandi ? <span class="rozet rozet-iyi">Resmi belgeyle doğrulandı</span> : <span class="rozet rozet-uyari">Doğrulanmadı</span>}
  </p>
  <p class="soluk">
    {guncelleme && <>Son güncelleme: {tarihYaz(guncelleme)} · </>}
    {belge && <>Belge son kontrol: {tarihYaz(belge.data.kontrolTarihi)} · </>}
    <a href={bildir} rel="noopener noreferrer">Hata bildir</a>
  </p>
</aside>
