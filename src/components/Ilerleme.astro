---
/**
 * Konu listesinin tamamlanma çubuğu. İlerleme tarayıcıdaki profilde olduğu için
 * gizli basılır; ilerleme.js doldurup gösterir. Konusu olmayan derste hiç basılmaz.
 */
interface Props {
  konular: string[];
  etiket: string;
}
const { konular, etiket } = Astro.props;
---
{konular.length > 0 && (
  <span class="ilerleme" data-ilerleme={JSON.stringify(konular)} hidden>
    <progress max="100" value="0" aria-label={`${etiket} ilerlemesi`}></progress>
    <span class="soluk" data-ilerleme-metin></span>
  </span>
)}
<script>
  import '../scripts/ilerleme.js';
</script>
