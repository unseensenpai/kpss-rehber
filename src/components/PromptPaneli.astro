---
/**
 * Hazır prompt kartları (spec §7). Konu sayfasında tek konu, prompt kütüphanesinde
 * sınav/konu seçimiyle çalışır. Build anında varsayılan ayarla doldurulmuş metin
 * basılır (JS olmadan da okunur); prompt-paneli.js profile göre yeniden doldurur.
 */
import { panelVerisi } from '../lib/prompt-paneli.js';
import { ogrenciAlanlariniAyir, promptDegerleri, promptDoldur } from '../lib/prompt-doldur.js';
import { GERI_BILDIRIMLER, VARSAYILAN } from '../lib/uyarlama.js';
import { SAGLAYICILAR } from '../lib/dis-ac.js';

interface Props {
  tum: any;
  konular: any[];
  kutuphane?: boolean;
}
const { tum, konular, kutuphane = false } = Astro.props;
const veri = panelVerisi(tum, konular);
const konuBul = (id: string) => veri.konular.find((k) => k.id === id)!;
// Kütüphanede ilk sınavın ilk konusuyla başlanır.
const ilkSinav = kutuphane ? veri.sinavlar[0] : null;
const ilkKonu = ilkSinav ? konuBul(ilkSinav.dersler[0].konular[0]) : veri.konular[0];
const baglam = ilkSinav ? ilkKonu.baglamlar.find((b) => b.sinavId === ilkSinav.id)! : ilkKonu.baglamlar[0];
const seviye = veri.seviyeler.find((s) => s.seviye === VARSAYILAN.seviye)!;
const uzunluk = veri.uzunluklar.find((u) => u.id === VARSAYILAN.uzunluk)!;
const degerler = promptDegerleri({ sinav: baglam.sinav, ders: baglam.ders, konu: ilkKonu, seviye, uzunluk });
---
<section class="prompt-paneli" data-pagefind-ignore data-prompt-paneli data-veri={JSON.stringify(veri)} data-kutuphane={kutuphane ? '' : undefined} aria-labelledby="prompt-baslik">
  <h2 id="prompt-baslik">{kutuphane ? 'Promptu hazırla' : 'Daha fazlası için: hazır promptlar'}</h2>
  <p class="soluk">
    Promptu kopyala ya da doğrudan ChatGPT veya Claude'da aç; açarken metin panoya da kopyalanır.
    <mark class="ogrenci-alani">[KÖŞELİ PARANTEZLİ]</mark> alanları göndermeden önce kendin doldur.
  </p>

  <div class="ayarlar">
    {kutuphane && (
      <>
        <label>Sınav
          <select data-sinav-sec>
            {veri.sinavlar.map((s) => <option value={s.id} selected={s.id === baglam.sinavId}>{s.kisaAd}</option>)}
          </select>
        </label>
        <label>Konu
          <select data-konu-sec>
            {ilkSinav!.dersler.map((d) => (
              <optgroup label={d.ad}>{d.konular.map((id) => <option value={id}>{konuBul(id).baslik}</option>)}</optgroup>
            ))}
          </select>
        </label>
      </>
    )}
    <label data-baglam-alan hidden={kutuphane || ilkKonu.baglamlar.length < 2}>Sınav bağlamı
      <select data-baglam>
        {ilkKonu.baglamlar.map((b, i) => <option value={i}>{b.kisaAd} · {b.ders}</option>)}
      </select>
    </label>
    <label>Seviye
      <select data-seviye>
        {veri.seviyeler.map((s) => <option value={s.seviye} selected={s.seviye === seviye.seviye}>{s.seviye} · {s.ad}</option>)}
      </select>
    </label>
    <label>Uzunluk
      <select data-uzunluk>
        {veri.uzunluklar.map((u) => <option value={u.id} selected={u.id === uzunluk.id}>{u.ad}</option>)}
      </select>
    </label>
  </div>
  <p class="uyari" data-kayit-uyari hidden>İlerleme kaydedilemiyor: tarayıcın bu site için depolamaya izin vermiyor. Ayarların sayfa kapanınca kaybolur.</p>

  <ul class="prompt-kartlari">
    {veri.sablonlar.map((s) => {
      const gorunur = ilkKonu.sablonlar.includes(s.id);
      const metin = gorunur ? promptDoldur(s.metin, degerler) : '';
      return (
        <li class="prompt-karti" data-sablon={s.id} hidden={!gorunur}>
          <h3>{s.baslik}</h3>
          <p class="soluk">{s.aciklama}</p>
          <details>
            <summary>Promptu gör</summary>
            <pre data-onizleme>{ogrenciAlanlariniAyir(metin).map((p) => (p.alan ? <mark class="ogrenci-alani">{p.metin}</mark> : p.metin))}</pre>
          </details>
          <div class="dugmeler">
            <button type="button" class="dugme" data-kopyala>📋 Kopyala</button>
            {Object.entries(SAGLAYICILAR).map(([id, sg]) => (
              <button type="button" class="dugme" data-ac={id}>{sg.dugme}</button>
            ))}
          </div>
          <p class="soluk bildirim" aria-live="polite" data-bildirim></p>
        </li>
      );
    })}
  </ul>

  <div class="geri-bildirim">
    <p><strong>Son prompt nasıldı?</strong> <span class="soluk">Seviye ve uzunluk bu konu için ayarlanır.</span></p>
    <div class="dugmeler">
      {Object.entries(GERI_BILDIRIMLER).map(([tur, g]) => (
        <button type="button" class="dugme" data-geri-bildirim={tur}>{g.etiket}</button>
      ))}
    </div>
    <p class="soluk" aria-live="polite" data-uyarlama-mesaji></p>
  </div>
</section>
<script>
  import '../scripts/prompt-paneli.js';
</script>
